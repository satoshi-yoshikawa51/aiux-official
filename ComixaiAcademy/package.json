{
  "name": "comixai-academy",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:extras": "node --experimental-strip-types --no-warnings tools/check-extras.mjs",
    "avatar:convert": "node tools/transcode-avatar.mjs",
    "avatar:check": "node tools/check-motions.mjs",
    "icons:app": "node tools/build-app-icon.mjs",
    "icons:ui": "node tools/build-icons.mjs",
    "stage": "node tools/build-stage.mjs",
    "stage:prepare": "node tools/prepare-stage.mjs",
    "fonts:subset": "node tools/subset-fonts.mjs",
    "tones": "node tools/make-tones.mjs",
    "emaki": "node --experimental-strip-types tools/sync-emaki.mjs",
    "build:web": "expo export --platform web",
    "sounds": "node tools/build-sounds.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~3.1.1",
    "expo": "^57.0.14",
    "expo-asset": "~57.0.7",
    "expo-audio": "^57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-three": "^8.0.0",
    "expo-video": "^57.0.2",
    "expo-web-browser": "~57.0.2",
    "gpt-tokenizer": "^3.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "0.162.0",
    "patch-package": "^8.0.1",
    "subset-font": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
