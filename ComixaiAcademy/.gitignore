# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# サブセット前のフルセットTTF（10MB超。npm run fonts:subset で取り直せる）
assets/fonts/_raw/

# Expo web export
dist/

# アイコンの確認用画像（node tools/build-icons.mjs で再生成できる）
tools/.icon-preview/

# 確認用のスクリーンショット置き場（作業中に混ざりやすい）
shots/
